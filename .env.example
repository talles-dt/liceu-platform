
# Sentry (production error monitoring)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=liceu-platform

# Server-only billing configuration. Keep false until test-mode acceptance passes.
NEXT_PUBLIC_SITE_URL=http://localhost:3187
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SALES_ENABLED=false
STRIPE_MONTHLY_PRICE_ID=
STRIPE_REVIEW_PRICE_ID=
STRIPE_MENTORING_PRICE_ID=
TRIAL_HASH_SECRET=
CAL_WEBHOOK_SECRET=
CRON_SECRET=
RESEND_API_KEY=
FROM_EMAIL=

# Server-to-server diagnostic email requests (never expose to the browser)
DIAGNOSTIC_WEBHOOK_SECRET=

# Server-only HMAC key (32+ characters) for password-recovery rate-limit identifiers.
RECOVERY_HASH_SECRET=
