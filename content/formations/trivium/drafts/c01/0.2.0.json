    "criteria": [
      {
        "key": "grammar.precision",
        "descriptors": {
          "support": "Troca referentes, negações ou voz do autor.",
          "developing": "Preserva o núcleo com ajuda; explica parcialmente as escolhas.",
          "consistent": "Preserva alcance e referentes; justifica duas revisões.",
          "transfer": "Aplica o cuidado em texto novo sem orientação pontual."
        }
      },
      {
        "key": "logic.inference",
        "descriptors": {
          "support": "Confunde opinião, razão e conclusão.",
          "developing": "Identifica a conclusão, mas omite uma ligação relevante.",
          "consistent": "Explicita razões, conclusão e um limite inferencial.",
          "transfer": "Reconstrói outro argumento e delimita o que falta saber."
        }
      },
      {
        "key": "rhetoric.expression",
        "descriptors": {
          "support": "Caricatura a posição ou não responde à objeção.",
          "developing": "Expõe com apoio e responde parcialmente.",
          "consistent": "Situa a fala, representa o outro com justiça e responde de modo pertinente.",
          "transfer": "Ajusta a exposição a outra audiência preservando o argumento."
        }
      }
    ]
  },
